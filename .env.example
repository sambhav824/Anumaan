# ==============================================================================
# अनुमान (Anumaan) — Multilingual Construction Estimation SaaS
# Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (apps/web)
# ------------------------------------------------------------------------------
# Supabase public credentials (safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default application language (en, mr, hi)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ------------------------------------------------------------------------------
# Backend (services/api)
# ------------------------------------------------------------------------------
# Environment mode: development, test, production
ENVIRONMENT=development

# Database Connection
# For production/staging with Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For local development/testing without live PostgreSQL:
DATABASE_URL=sqlite+aiosqlite:///./anumaan.db

# Supabase Auth & JWT Verification
SUPABASE_URL=https://your-project.supabase.co
# Found in Supabase Project Settings -> API -> JWT Secret:
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-characters-long

# Supabase Service Role Key (Backend ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
