# ==============================================================================
# Anumaan API Service — Environment Template
# ==============================================================================

# Environment mode: development, test, production
ENVIRONMENT=development

# Database Connection
# Local development default:
DATABASE_URL=sqlite+aiosqlite:///./anumaan.db
# Production / Staging Supabase PostgreSQL connection pooler (Transaction pooler port 6543 or Session pooler port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Auth & JWT Verification
SUPABASE_URL=https://your-project-ref.supabase.co
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret:
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-characters-long

# Supabase Service Role Key (Backend ONLY — NEVER expose to browser or client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed CORS Origins (comma-separated list of web origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting (true/false)
RATE_LIMIT_ENABLED=true
